# Copy these settings into Streamlit Community Cloud's Advanced settings.
# Keep the real key in the platform's secret store, never in GitHub.
GLUCOTRUST_PROVIDER = "groq"
GLUCOTRUST_GROQ_MODEL = "openai/gpt-oss-20b"
GROQ_API_KEY = "replace-with-your-private-key"
GLUCOTRUST_TIMEOUT_SECONDS = 60
GLUCOTRUST_REQUESTS_PER_MINUTE = 6
GLUCOTRUST_MAX_CONCURRENT_REQUESTS = 1
