GLUCOTRUST_PROVIDER=ollama
GLUCOTRUST_MODEL=qwen3:4b-instruct-2507-q4_K_M
GLUCOTRUST_OLLAMA_HOST=http://localhost:11434
GLUCOTRUST_TIMEOUT_SECONDS=180
